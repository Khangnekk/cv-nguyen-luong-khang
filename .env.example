# Cau hinh app. Copy file nay thanh .env roi chinh value.
# File .env da duoc .gitignore, khong commit gia tri that.

# URL chinh cua trang web. Dung cho JSON-LD Person (url, mainEntityOfPage)
# va cho viec chia se link. De trong = bo qua field url trong JSON-LD.
# Vi du: https://khangnguyenluong.dev
VITE_SITE_URL=https://cv-nguyen-luong-khang.pages.dev

# Mode mo khi load trang: human | pdf | agent
#   human = CV HTML co mau, chu doi in 1 trang A4
#   pdf   = raw PDF trong iframe
#   agent = ban markdown plain-text cho LLM/agent doc
# Mac dinh: pdf
VITE_DEFAULT_VIEW=pdf

# Ten file raw PDF trong thu muc public/
# Mac dinh: cv.pdf
VITE_PDF_FILE=cv.pdf

# Ten file markdown cho agent, duoc sinh tu src/data/cv.ts luc build
# Mac dinh: cv.md
VITE_AGENT_FILE=cv.md
